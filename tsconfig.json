{
  "compileOnSave": false,
  "files": [],
  "references": [
    { "path": "./tsconfig.tools.json" },
    { "path": "./tsconfig.spec.json" },
    { "path": "./projects/antoniocorraliza/foundry-core/tsconfig.lib.json" },
    { "path": "./projects/antoniocorraliza/foundry-ui/tsconfig.lib.json" },
    { "path": "./projects/antoniocorraliza/foundry-utils/tsconfig.lib.json" }
  ],
  "compilerOptions": {
    "paths": {
      "@antoniocorraliza/foundry-core": ["./projects/antoniocorraliza/foundry-core/src/public-api.ts"],
      "@antoniocorraliza/foundry-core/*": ["./projects/antoniocorraliza/foundry-core/*/src/public-api.ts"],
      "@antoniocorraliza/foundry-ui": ["./projects/antoniocorraliza/foundry-ui/src/public-api.ts"],
      "@antoniocorraliza/foundry-ui/*": ["./projects/antoniocorraliza/foundry-ui/*/src/public-api.ts"],
      "@antoniocorraliza/foundry-utils": ["./projects/antoniocorraliza/foundry-utils/src/public-api.ts"],
      "@antoniocorraliza/foundry-utils/*": ["./projects/antoniocorraliza/foundry-utils/*/src/public-api.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": false,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
