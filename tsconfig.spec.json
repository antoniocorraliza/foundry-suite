/* The Angular plugin of Vitest compiles with this file, so it must not set noEmit. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals", "node"],
    "paths": {
      "@antoniocorraliza/foundry-core": ["./projects/antoniocorraliza/foundry-core/src/public-api.ts"],
      "@antoniocorraliza/foundry-core/*": ["./projects/antoniocorraliza/foundry-core/*/src/public-api.ts"],
      "@antoniocorraliza/foundry-ui": ["./projects/antoniocorraliza/foundry-ui/src/public-api.ts"],
      "@antoniocorraliza/foundry-ui/*": ["./projects/antoniocorraliza/foundry-ui/*/src/public-api.ts"],
      "@antoniocorraliza/foundry-utils": ["./projects/antoniocorraliza/foundry-utils/src/public-api.ts"],
      "@antoniocorraliza/foundry-utils/*": ["./projects/antoniocorraliza/foundry-utils/*/src/public-api.ts"],
      "@foundry-test/*": ["./tools/vitest/*"]
    }
  },
  "include": [
    "projects/**/*.spec.ts",
    "projects/**/*.test-d.ts",
    "tools/vitest/setup/*.ts",
    "tools/vitest/smoke/*.spec.ts",
    "tools/vitest/provided-context.d.ts"
  ]
}
