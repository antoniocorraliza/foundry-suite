/* Node runs these files directly, so tsc only type-checks them. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "vitest.config.ts",
    "tools/vitest/projects.ts",
    "tools/vitest/constants/*.ts",
    "tools/vitest/interfaces/*.ts",
    "tools/vitest/smoke/smoke.projects.ts",
    "tools/packages/**/*.ts",
    "tools/ci/*.ts",
    "tools/ci/constants/*.ts",
    "tools/ci/interfaces/*.ts",
    "tools/lint/**/*.ts"
  ]
}
