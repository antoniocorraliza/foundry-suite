/* Node runs these files directly, so tsc only type-checks them. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["vitest.config.ts", "tools/**/*.ts"],
  "exclude": ["tools/vitest/setup/**", "tools/vitest/smoke/**/*.spec.ts", "tools/ci/angular-22/**"]
}
