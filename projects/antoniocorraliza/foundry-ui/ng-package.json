{
  "$schema": "../../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../../dist/antoniocorraliza/foundry-ui",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "input": "styles",
      "glob": "**/*.{css,woff2}",
      "output": "styles"
    },
    {
      "input": "styles/fonts",
      "glob": "OFL.txt",
      "output": "styles/fonts"
    }
  ]
}